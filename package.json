{
  "name": "@openidentity/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for OpenIdentity Protocol v0.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run protocol:verify && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "protocol:verify": "node tools/verify-protocol-resources.mjs",
    "release:gate": "npm run verify && npm run package:smoke && node tools/release-gate-pass.mjs",
    "prepack": "npm run build",
    "package:smoke": "node tools/package-smoke.mjs"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.19.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathon-ross/openidentity-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/jonathon-ross/openidentity-typescript/issues"
  },
  "homepage": "https://github.com/jonathon-ross/openidentity-typescript#readme",
  "keywords": [
    "openidentity",
    "identity",
    "credentials",
    "did",
    "ed25519",
    "ml-dsa",
    "post-quantum"
  ],
  "publishConfig": {
    "access": "public"
  }
}
